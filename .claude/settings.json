{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(pnpm install)",
			"Bash(pnpm dev)",
			"Bash(pnpm build)",
			"Bash(pnpm start)",
			"Bash(pnpm biome check)",
			"Bash(pnpm biome check --write)",
			"Bash(biome check)",
			"Bash(biome check --write)",
			"Bash(git status)",
			"Bash(git status:*)",
			"Bash(git diff)",
			"Bash(git diff:*)"
		],
		"deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*)"]
	}
}
