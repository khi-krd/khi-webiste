# KHI Website — environment template
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Variables marked "build-time" are inlined during `next build` (NEXT_PUBLIC_* and
# ENABLE_HSTS). Changing them in a running container requires a rebuild.
# Runtime variables can be changed without rebuilding the image.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# CMS REST API base URL (runtime). Without this every CMS fetch returns null.
API_BASE_URL=https://api.example.com

# Canonical public site origin (build-time). Drives metadataBase, canonical
# URLs, hreflang, sitemap.xml, and robots.txt. Must be https in production.
NEXT_PUBLIC_SITE_URL=https://khi.example

# ---------------------------------------------------------------------------
# CMS caching & on-demand revalidation (runtime)
# ---------------------------------------------------------------------------

# ISR TTL in seconds for upstream CMS fetches.
# 0 or unset = no-store (fresh data on every request; default).
API_REVALIDATE_SECONDS=0

# Shared secret for POST /api/revalidate (header: x-revalidation-secret).
# Required when API_REVALIDATE_SECONDS > 0 so CMS publish hooks can bust cache.
# REVALIDATION_SECRET=

# Legacy alias for API_REVALIDATE_SECONDS (prefer API_REVALIDATE_SECONDS).
# REVALIDATE_SECONDS=

# Optional Cloudflare edge purge when /api/revalidate is called.
# Both must be set; otherwise Cloudflare purge is skipped.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Media (build-time)
# ---------------------------------------------------------------------------

# Primary S3/CDN hostname; used for PDF proxy hints and media URL resolution.
NEXT_PUBLIC_MEDIA_HOST=media.example.com

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------

# off   — always use the live CMS (default)
# full  — fixtures only; API_BASE_URL not required; media URLs will be broken
# auto  — use fixtures when the CMS returns empty/sparse data

# ---------------------------------------------------------------------------
# Theme (build-time)
# ---------------------------------------------------------------------------

# "true" enables rounded corners via <html data-corners="rounded">.
NEXT_PUBLIC_ENABLE_BORDER_RADIUS=false

# Corner radius preset when enabled: s | m | l | xl
NEXT_PUBLIC_BORDER_RADIUS=m

# ---------------------------------------------------------------------------
# Build-only (optional — usually set on the CLI or in Docker build args)
# ---------------------------------------------------------------------------

# Send Strict-Transport-Security. Only enable once HTTPS works end to end.
# ENABLE_HSTS=false

# Emit a bundle treemap: ANALYZE=true pnpm build
# ANALYZE=false
